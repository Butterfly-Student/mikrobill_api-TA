### ========================================
### AUTH API TESTS
### ========================================
@baseUrl = http://localhost:8000

### ========================================
### 1. SUPERADMIN LOGIN
### ========================================
# @name loginSuperAdmin
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "username": "superadmin@mikrobill.com",
  "password": "password123"
}

### Extract tokens for subsequent requests
@accessToken = {{loginSuperAdmin.response.body.data.access_token}}
@refreshToken = {{loginSuperAdmin.response.body.data.refresh_token}}

### ========================================
### 2. REGISTER NEW USER
### ========================================
# @name registerUser
POST {{baseUrl}}/v1/auth/register
Content-Type: application/json

{
  "username": "newuser",
  "email": "newuser@example.com",
  "password": "password123",
  "fullname": "New User Test",
  "phone": "081234567890"
}

### ========================================
### 3. GET PROFILE (Authenticated)
### ========================================
GET {{baseUrl}}/v1/auth/profile
Authorization: Bearer {{accessToken}}

### ========================================
### 4. REFRESH ACCESS TOKEN
### ========================================
# @name refreshToken
POST {{baseUrl}}/v1/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### Extract new tokens
@newAccessToken = {{refreshToken.response.body.data.access_token}}
@newRefreshToken = {{refreshToken.response.body.data.refresh_token}}

### ========================================
### 5. LOGOUT
### ========================================
POST {{baseUrl}}/v1/auth/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "refresh_token": "{{refreshToken}}"
}

### ========================================
### TENANT ADMIN LOGINS
### ========================================

### TEKNOLOGI NUSANTARA - ADMIN
# @name loginTeknusantaraAdmin
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "username": "admin@teknusantara.com",
  "password": "password123"
}

@teknusantaraToken = {{loginTeknusantaraAdmin.response.body.data.access_token}}

